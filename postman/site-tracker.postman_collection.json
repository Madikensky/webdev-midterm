{
  "info": {
    "name": "Site-Tracker API",
    "description": "Run the requests top to bottom (or use the Collection Runner). Create site stores its id in {{siteId}} for the get, update and delete requests.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "siteId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Health check",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"status is ok\", function () { pm.expect(pm.response.json().status).to.eql(\"ok\"); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "health"
          ]
        }
      }
    },
    {
      "name": "List sites",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"Body is an array\", function () { pm.expect(pm.response.json()).to.be.an(\"array\"); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/sites",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "sites"
          ]
        }
      }
    },
    {
      "name": "Create site",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 201\", function () { pm.response.to.have.status(201); });",
              "var site = pm.response.json();",
              "pm.test(\"Returns created site with id\", function () { pm.expect(site.id).to.be.a(\"number\"); pm.expect(site.name).to.eql(\"Postman Site\"); });",
              "pm.collectionVariables.set(\"siteId\", site.id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/sites",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "sites"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Postman Site\",\n  \"address\": \"1 Test St\",\n  \"city\": \"Almaty\",\n  \"status\": \"active\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Get site by id",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"Returns the created site\", function () { pm.expect(pm.response.json().id).to.eql(Number(pm.collectionVariables.get(\"siteId\"))); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/sites/{{siteId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "sites",
            "{{siteId}}"
          ]
        }
      }
    },
    {
      "name": "Update site",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"Fields were updated\", function () { var s = pm.response.json(); pm.expect(s.name).to.eql(\"Postman Site (updated)\"); pm.expect(s.status).to.eql(\"inactive\"); });"
            ]
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/sites/{{siteId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "sites",
            "{{siteId}}"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Postman Site (updated)\",\n  \"address\": \"2 Test St\",\n  \"city\": \"Astana\",\n  \"status\": \"inactive\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Create site - missing name (400)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 400\", function () { pm.response.to.have.status(400); });"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/sites",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "sites"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"city\": \"Almaty\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Get site - not found (404)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 404\", function () { pm.response.to.have.status(404); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/sites/999999",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "sites",
            "999999"
          ]
        }
      }
    },
    {
      "name": "Get site - invalid id (400)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 400\", function () { pm.response.to.have.status(400); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/sites/abc",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "sites",
            "abc"
          ]
        }
      }
    },
    {
      "name": "Delete site",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 204\", function () { pm.response.to.have.status(204); });"
            ]
          }
        }
      ],
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/sites/{{siteId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "sites",
            "{{siteId}}"
          ]
        }
      }
    },
    {
      "name": "Get deleted site (404)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 404\", function () { pm.response.to.have.status(404); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/sites/{{siteId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "sites",
            "{{siteId}}"
          ]
        }
      }
    }
  ]
}